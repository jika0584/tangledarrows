# Copy to .env and fill in. Both are safe to ship in the client bundle:
# the anon key is public and must be paired with row-level security in Supabase.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# PX generator only. Bypasses RLS so it can insert levels. Never put this in the app.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional. Lets PX create the project and table for you (supabase.com account token).
SUPABASE_ACCESS_TOKEN=
